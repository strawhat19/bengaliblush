rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function boundedList(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }
    function hasStatus(data, status) {
      return data.keys().hasAny(['account_status']) ? data.account_status == status : status == 'active';
    }
    function ownProfile(id) {
      return signedIn() && exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id == id;
    }
    function activeAccount() {
      return signedIn() && exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid))
        && !get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.keys().hasAny(['account_status'])
        && exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id))
        && get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id)).data.firebase_uid == request.auth.uid
        && hasStatus(get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id)).data, 'active');
    }
    function activeAccountAfter() {
      let mapping = getAfter(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data;
      let account = getAfter(/databases/$(database)/documents/users/$(mapping.user_id)).data;
      return !mapping.keys().hasAny(['account_status']) && account.firebase_uid == request.auth.uid && hasStatus(account, 'active');
    }
    function isOwner() {
      return activeAccount()
        && get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id)).data.role == 'owner';
    }
    function isAdmin() {
      return activeAccount()
        && get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id)).data.role in ['admin', 'owner'];
    }
    function recentlyAuthenticated() {
      return signedIn() && request.auth.token.auth_time is int
        && request.time.toMillis() - request.auth.token.auth_time * 1000 <= 600000;
    }
    function deletingAccount() {
      return signedIn() && exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.account_status == 'deleting';
    }
    function validText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function exactKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }
    function featureSettingsPath() {
      return /databases/$(database)/documents/featureSettings/$('FeatureSettings_1_Global_4_23_PM_10_12_26_b39e4e10-d4d7-41cf-9c5f-40a6a4703e90');
    }
    function featureViewerRole() {
      return !signedIn() ? 'guest' : (activeAccount()
        ? get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id)).data.role : '');
    }
    function validFeatureAudience(data) {
      return data is map && exactKeys(data, ['roles', 'plans', 'planMode']) && data.planMode == 'minimum'
        && (data.roles == null || (data.roles is list && data.roles.size() <= 4
          && data.roles.hasOnly(['guest', 'admin', 'owner', 'subscriber']) && data.roles.size() == data.roles.toSet().size()))
        && (data.plans == null || (data.plans is list && data.plans.size() == 1 && validSlug(data.plans[0])));
    }
    function validFeature(data) {
      return data is map && exactKeys(data, ['enabled', 'description', 'audience']) && data.enabled is bool
        && validText(data.description, 0, 1000) && validFeatureAudience(data.audience);
    }
    function validFeatureSettings(data, id) {
      return exactKeys(data, ['id', 'name', 'type', 'number', 'version', 'features', 'created_at', 'updated_at'])
        && id == 'FeatureSettings_1_Global_4_23_PM_10_12_26_b39e4e10-d4d7-41cf-9c5f-40a6a4703e90'
        && validIdentity(data, id, 'FeatureSettings') && data.number == 1
        && data.type == 'FeatureSettings' && data.name == 'Global' && data.version is int && data.version == 1
        && data.created_at is timestamp && data.updated_at is timestamp && data.features is map
        && exactKeys(data.features, ['themeToggle', 'marquee', 'notifications', 'contact'])
        && validFeature(data.features.themeToggle) && validFeature(data.features.marquee)
        && validFeature(data.features.notifications) && validFeature(data.features.contact);
    }
    function freeFeaturePlans(data) {
      return data.features.themeToggle.audience.plans == null && data.features.marquee.audience.plans == null
        && data.features.notifications.audience.plans == null && data.features.contact.audience.plans == null;
    }
    function retainedMinimumPlan(next, previous) {
      return next.audience.plans == null || next.audience.plans == previous.audience.plans;
    }
    function retainedFeaturePlans(next, previous) {
      return retainedMinimumPlan(next.features.themeToggle, previous.features.themeToggle)
        && retainedMinimumPlan(next.features.marquee, previous.features.marquee)
        && retainedMinimumPlan(next.features.notifications, previous.features.notifications)
        && retainedMinimumPlan(next.features.contact, previous.features.contact);
    }
    function eligibleFeature(data, role) {
      return data.enabled && data.audience.plans == null
        && (data.audience.roles == null || role in data.audience.roles);
    }
    function featureEnabled(key) {
      let role = featureViewerRole();
      return role in ['guest', 'admin', 'owner', 'subscriber']
        && (!exists(featureSettingsPath()) || (validFeatureSettings(get(featureSettingsPath()).data,
          'FeatureSettings_1_Global_4_23_PM_10_12_26_b39e4e10-d4d7-41cf-9c5f-40a6a4703e90')
          && eligibleFeature(get(featureSettingsPath()).data.features[key], role)));
    }
    function validIdentity(data, id, type) {
      return data.id == id && data.number is int && data.number > 0
        && id.matches(type + '_' + string(data.number) + '_[A-Za-z0-9]+_[A-Za-z0-9_]+_[a-f0-9-]+');
    }
    function matchingCounter(collectionName, id, number) {
      let counter = getAfter(/databases/$(database)/documents/counters/$(collectionName)).data;
      return counter.record_id == id && counter.number == number
        && counter.number == (exists(/databases/$(database)/documents/counters/$(collectionName))
          ? get(/databases/$(database)/documents/counters/$(collectionName)).data.number + 1 : 1);
    }
    function submissionActor(data) {
      return (data.user_id == '' && data.firebase_uid == '')
        || (activeAccount() && data.firebase_uid == request.auth.uid
          && data.user_id == get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id);
    }
    function validCounterRecord(collectionName, id, number) {
      let data = getAfter(/databases/$(database)/documents/$(collectionName)/$(id)).data;
      return data.id == id && data.number == number
        && ((collectionName == 'users' && signedIn() && activeAccountAfter() && data.firebase_uid == request.auth.uid)
          || (collectionName in ['contactSubmissions', 'appointmentSubmissions', 'orders'] && submissionActor(data)
            && data.created_at == request.time && data.updated_at == request.time)
          || (collectionName in ['events', 'products', 'services', 'reviews', 'paymentMethods', 'notifications'] && isAdmin()
            && data.created_at == request.time && data.updated_at == request.time)
          || (collectionName == 'roleChanges' && validRoleChange(data, id) && authorizedRoleChange(data))
          || (collectionName == 'featureSettings' && isOwner() && number == 1 && validFeatureSettings(data, id)
            && freeFeaturePlans(data) && data.created_at == request.time && data.updated_at == request.time));
    }
    function validUser(data, id) {
      return data.keys().hasAll(['id', 'name', 'email', 'number', 'role', 'photo_url', 'created_at', 'updated_at', 'firebase_uid', 'provider', 'profile_visibility'])
        && data.keys().hasOnly(['id', 'name', 'email', 'number', 'role', 'photo_url', 'created_at', 'updated_at', 'firebase_uid', 'provider', 'profile_visibility', 'theme_mode', 'account_status'])
        && validIdentity(data, id, 'User')
        && validText(data.name, 1, 120) && validText(data.email, 3, 254)
        && validText(data.photo_url, 0, 2048) && validText(data.firebase_uid, 1, 128)
        && data.role in ['subscriber', 'admin', 'owner'] && data.provider in ['google', 'password'] && data.profile_visibility == 'private'
        && (!data.keys().hasAny(['theme_mode']) || data.theme_mode in ['light', 'dark'])
        && (!data.keys().hasAny(['account_status']) || data.account_status in ['active', 'deactivated', 'deleting'])
        && data.created_at is timestamp && data.updated_at is timestamp;
    }
    function validRoleChange(data, id) {
      return exactKeys(data, ['id', 'number', 'actor_id', 'target_id', 'actor_firebase_uid', 'previous_role', 'next_role', 'created_at'])
        && validIdentity(data, id, 'RoleChange')
        && validText(data.actor_id, 1, 200) && validText(data.target_id, 1, 200)
        && validText(data.actor_firebase_uid, 1, 128) && data.created_at is timestamp
        && data.previous_role in ['subscriber', 'admin', 'owner'] && data.next_role in ['subscriber', 'admin', 'owner']
        && data.previous_role != data.next_role;
    }
    function authorizedRoleChange(data) {
      let actorId = get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id;
      let actorAfter = getAfter(/databases/$(database)/documents/users/$(actorId)).data;
      let previous = get(/databases/$(database)/documents/users/$(data.target_id)).data;
      let next = getAfter(/databases/$(database)/documents/users/$(data.target_id)).data;
      return isOwner() && actorAfter.role == 'owner' && hasStatus(actorAfter, 'active')
        && data.actor_id == actorId && data.actor_firebase_uid == request.auth.uid && data.target_id != actorId
        && previous.firebase_uid != request.auth.uid && !hasStatus(previous, 'deleting')
        && data.previous_role == previous.role && data.next_role == next.role && data.created_at == request.time
        && next.updated_at == request.time && next.diff(previous).affectedKeys().hasOnly(['role', 'updated_at']);
    }
    function auditedRoleUpdate(data, id) {
      let counter = getAfter(/databases/$(database)/documents/counters/roleChanges).data;
      let change = getAfter(/databases/$(database)/documents/roleChanges/$(counter.record_id)).data;
      return !ownProfile(id) && resource.data.firebase_uid != request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly(['role', 'updated_at'])
        && !exists(/databases/$(database)/documents/roleChanges/$(counter.record_id))
        && validRoleChange(change, counter.record_id) && change.target_id == id
        && change.actor_id == get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id
        && change.actor_firebase_uid == request.auth.uid && change.created_at == request.time
        && change.previous_role == resource.data.role && change.next_role == data.role
        && matchingCounter('roleChanges', counter.record_id, change.number);
    }
    function validSubmission(data, id, type) {
      return validIdentity(data, id, type)
        && validText(data.user_id, 0, 200) && validText(data.firebase_uid, 0, 128)
        && ((data.user_id == '' && data.firebase_uid == '') || (data.user_id.size() > 0 && data.firebase_uid.size() > 0))
        && data.created_at is timestamp && data.updated_at is timestamp;
    }
    function validContact(data, id) {
      return exactKeys(data, ['id', 'number', 'user_id', 'created_at', 'updated_at', 'firebase_uid', 'status', 'contact', 'message'])
        && validSubmission(data, id, 'ContactSubmission')
        && validText(data.contact, 1, 254) && validText(data.message, 1, 5000)
        && data.status in ['new', 'reviewed', 'completed'];
    }
    function validAppointment(data, id) {
      return exactKeys(data, ['id', 'number', 'user_id', 'created_at', 'updated_at', 'firebase_uid', 'status', 'name', 'date', 'time', 'email', 'notes', 'service'])
        && validSubmission(data, id, 'AppointmentSubmission')
        && validText(data.name, 1, 120) && validText(data.time, 1, 40) && validText(data['service'], 1, 160)
        && validText(data.notes, 0, 5000) && validText(data.email, 3, 254)
        && data.email.matches('[^\\s@]+@[^\\s@]+\\.[^\\s@]+')
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.status in ['requested', 'confirmed', 'declined', 'completed'];
    }
    function newSubmission(data, collectionName, id) {
      return submissionActor(data)
        && data.created_at == request.time && data.updated_at == request.time
        && matchingCounter(collectionName, id, data.number);
    }
    function immutableSubmissionFields(data) {
      return data.id == resource.data.id && data.number == resource.data.number
        && data.user_id == resource.data.user_id && data.firebase_uid == resource.data.firebase_uid
        && data.created_at == resource.data.created_at && data.updated_at == request.time;
    }
    function ownLifecycleUpdate(data, id) {
      return ownProfile(id) && resource.data.firebase_uid == request.auth.uid && recentlyAuthenticated()
        && data.diff(resource.data).affectedKeys().hasOnly(['account_status', 'updated_at'])
        && ((hasStatus(resource.data, 'active') && data.account_status == 'deactivated')
          || (hasStatus(resource.data, 'deactivated') && data.account_status == 'active')
          || ((hasStatus(resource.data, 'active') || hasStatus(resource.data, 'deactivated')) && data.account_status == 'deleting'
            && getAfter(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.account_status == 'deleting'
            && getAfter(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id == id));
    }
    function ownSubmissionDelete(data) {
      return deletingAccount() && recentlyAuthenticated() && data.firebase_uid == request.auth.uid
        && data.user_id == get(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id;
    }
    function ownerSubmissionWrite(data) {
      return isOwner() && (data.firebase_uid == '' || !exists(/databases/$(database)/documents/accountAccess/$(data.firebase_uid))
        || !get(/databases/$(database)/documents/accountAccess/$(data.firebase_uid)).data.keys().hasAny(['account_status']));
    }
    function adminSubmissionWrite(data) {
      return isAdmin() && (data.firebase_uid == '' || !exists(/databases/$(database)/documents/accountAccess/$(data.firebase_uid))
        || !get(/databases/$(database)/documents/accountAccess/$(data.firebase_uid)).data.keys().hasAny(['account_status']));
    }
    function validCommerceRecord(data, id, type) {
      return validIdentity(data, id, type) && data.created_at is timestamp && data.updated_at is timestamp;
    }
    function immutableCommerceFields(data) {
      return data.id == resource.data.id && data.number == resource.data.number
        && data.created_at == resource.data.created_at && data.updated_at == request.time;
    }
    function newCommerceRecord(data, collectionName, id) {
      return isAdmin() && data.created_at == request.time && data.updated_at == request.time
        && matchingCounter(collectionName, id, data.number);
    }
    function validSlug(value) {
      return validText(value, 1, 100) && value.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }
    function validImage(value) {
      return validText(value, 0, 2048) && value.matches('[^\\s]*') && !value.matches('.*\\\\.*')
        && (value == '' || value == '/' || value.matches('/[^/].*') || value.matches('https?://[^/\\s]+.*'));
    }
    function matchingSlug(collectionName, data) {
      let reservation = getAfter(/databases/$(database)/documents/catalogSlugs/$(collectionName + '_' + data.slug)).data;
      return reservation.record_id == data.id && reservation.slug == data.slug && reservation.collection_name == collectionName;
    }
    function validProduct(data, id) {
      return data.keys().hasAll(['id', 'number', 'created_at', 'updated_at', 'slug', 'name', 'description', 'price', 'price_minor', 'label', 'shade', 'image', 'imageAlt', 'category_id', 'category_name', 'status'])
        && data.keys().hasOnly(['id', 'number', 'created_at', 'updated_at', 'slug', 'name', 'description', 'price', 'price_minor', 'label', 'shade', 'image', 'imageAlt', 'visual', 'category_id', 'category_name', 'status'])
        && validCommerceRecord(data, id, 'Product') && validSlug(data.slug) && validSlug(data.category_id)
        && validText(data.name, 1, 120) && validText(data.description, 1, 5000) && validText(data.category_name, 1, 120)
        && validText(data.label, 0, 120) && validText(data.shade, 1, 60)
        && validImage(data.image) && validText(data.imageAlt, 0, 300)
        && data.price_minor is int && data.price_minor >= 0 && data.price_minor <= 100000000
        && data.price is number && data.price == data.price_minor / 100.0
        && (!data.keys().hasAny(['visual']) || data.visual in ['serum', 'apparel', 'candle', 'tool'])
        && data.status in ['active', 'archived'];
    }
    function validService(data, id) {
      return exactKeys(data, ['id', 'number', 'created_at', 'updated_at', 'slug', 'legacy_id', 'name', 'description', 'price', 'duration', 'image', 'imageAlt', 'overview', 'highlights', 'preparation', 'relatedBlogSlugs', 'faqs', 'status'])
        && validCommerceRecord(data, id, 'Service') && validSlug(data.slug) && validSlug(data.legacy_id)
        && validText(data.name, 1, 120) && validText(data.description, 1, 5000)
        && validText(data.price, 1, 80) && validText(data.duration, 1, 120)
        && validImage(data.image) && validText(data.imageAlt, 0, 300)
        && data.overview is list && data.overview.size() <= 30 && data.highlights is list && data.highlights.size() <= 30
        && data.preparation is list && data.preparation.size() <= 30 && data.relatedBlogSlugs is list && data.relatedBlogSlugs.size() <= 30
        && data.faqs is list && data.faqs.size() <= 20 && data.status in ['active', 'archived'];
    }
    function validReview(data, id) {
      return exactKeys(data, ['id', 'number', 'created_at', 'updated_at', 'name', 'rating', 'image', 'imageAlt', 'quote', 'service', 'heading', 'status'])
        && validCommerceRecord(data, id, 'Review') && validText(data.name, 1, 120) && validText(data.quote, 1, 5000)
        && validText(data['service'], 1, 160) && validImage(data.image) && validText(data.imageAlt, 0, 300)
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.heading is map && exactKeys(data.heading, ['first', 'accent', 'last'])
        && validText(data.heading.first, 0, 120) && validText(data.heading.accent, 0, 120) && validText(data.heading.last, 0, 120)
        && data.status in ['published', 'draft', 'archived'];
    }
    function validPaymentMethod(data, id) {
      return exactKeys(data, ['id', 'number', 'created_at', 'updated_at', 'name', 'description', 'type', 'status'])
        && validCommerceRecord(data, id, 'PaymentMethod') && validText(data.name, 1, 120) && validText(data.description, 0, 1000)
        && data.type in ['manual', 'card'] && data.status in ['active', 'disabled']
        && (data.type != 'card' || data.status == 'disabled');
    }
    function validNotificationLink(link) {
      return link is map && exactKeys(link, ['href', 'label']) && validText(link.label, 1, 120)
        && validText(link.href, 1, 2048) && link.href.matches('[^\\s]*') && !link.href.matches('.*\\\\.*')
        && (link.href == '/' || link.href.matches('/[^/].*') || link.href.matches('https?://[^/\\s@]+(/.*)?'));
    }
    function validNotification(data, id) {
      return data.keys().hasAll(['id', 'number', 'body', 'slug', 'title', 'kind', 'status', 'created_at', 'updated_at'])
        && data.keys().hasOnly(['id', 'number', 'body', 'slug', 'title', 'kind', 'status', 'created_at', 'updated_at', 'suffix', 'link'])
        && validCommerceRecord(data, id, 'Notification') && validSlug(data.slug)
        && validText(data.title, 1, 160) && validText(data.body, 1, 5000)
        && data.kind in ['development', 'announcement'] && data.status in ['draft', 'published']
        && (!data.keys().hasAny(['suffix']) || validText(data.suffix, 0, 300))
        && (!data.keys().hasAny(['link']) || validNotificationLink(data.link));
    }
    function validEvent(data, id) {
      return exactKeys(data, ['id', 'number', 'title', 'description', 'date', 'time', 'location', 'status', 'created_at', 'updated_at'])
        && validCommerceRecord(data, id, 'Event')
        && validText(data.title, 1, 160) && validText(data.description, 0, 5000) && validText(data.location, 0, 240)
        && data.date is string && data.date.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && data.time is string && (data.time == '' || data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
        && data.status in ['draft', 'scheduled', 'cancelled'];
    }
    function validOrderItem(item) {
      return item is map && exactKeys(item, ['product_id', 'name', 'quantity', 'unit_price'])
        && validText(item.product_id, 1, 200) && !item.product_id.matches('.*[/].*') && validText(item.name, 1, 120)
        && item.quantity is int && item.quantity >= 1 && item.quantity <= 99
        && item.unit_price is int && item.unit_price >= 0 && item.unit_price <= 100000000;
    }
    function orderItemAt(items, index) {
      return index >= items.size() || validOrderItem(items[index]);
    }
    function distinctOrderItems(items, first, second) {
      return second >= items.size() || items[first].product_id != items[second].product_id;
    }
    function orderLineTotal(items, index) {
      return index < items.size() ? items[index].quantity * items[index].unit_price : 0;
    }
    function validOrderItems(items) {
      return items is list && items.size() >= 1 && items.size() <= 5
        && orderItemAt(items, 0) && orderItemAt(items, 1) && orderItemAt(items, 2) && orderItemAt(items, 3) && orderItemAt(items, 4)
        && distinctOrderItems(items, 0, 1) && distinctOrderItems(items, 0, 2) && distinctOrderItems(items, 0, 3) && distinctOrderItems(items, 0, 4)
        && distinctOrderItems(items, 1, 2) && distinctOrderItems(items, 1, 3) && distinctOrderItems(items, 1, 4)
        && distinctOrderItems(items, 2, 3) && distinctOrderItems(items, 2, 4) && distinctOrderItems(items, 3, 4);
    }
    function trustedOrderItem(item) {
      let product = get(/databases/$(database)/documents/products/$(item.product_id)).data;
      return product.status == 'active' && item.name == product.name
        && product.price is number && product.price >= 0 && product.price <= 1000000
        && item.unit_price == math.round(product.price * 100);
    }
    function trustedOrderItemAt(items, index) {
      return index >= items.size() || trustedOrderItem(items[index]);
    }
    function trustedOrderItems(items) {
      return trustedOrderItemAt(items, 0) && trustedOrderItemAt(items, 1) && trustedOrderItemAt(items, 2)
        && trustedOrderItemAt(items, 3) && trustedOrderItemAt(items, 4);
    }
    function availablePaymentMethod(id) {
      return id == '' || (get(/databases/$(database)/documents/paymentMethods/$(id)).data.status == 'active'
        && get(/databases/$(database)/documents/paymentMethods/$(id)).data.type == 'manual');
    }
    function validOrder(data, id) {
      return exactKeys(data, ['id', 'number', 'created_at', 'updated_at', 'user_id', 'firebase_uid', 'name', 'email', 'phone', 'notes', 'city', 'region', 'address', 'country', 'postal_code', 'items', 'subtotal', 'currency', 'status', 'payment_status', 'payment_method_id'])
        && validSubmission(data, id, 'Order') && validText(data.name, 1, 120) && validText(data.email, 3, 254)
        && data.email.matches('[^\\s@]+@[^\\s@]+\\.[^\\s@]+') && validText(data.phone, 0, 40) && validText(data.notes, 0, 5000)
        && validText(data.city, 1, 120) && validText(data.region, 0, 120) && validText(data.address, 1, 300)
        && validText(data.country, 1, 120) && validText(data.postal_code, 1, 40)
        && validText(data.payment_method_id, 0, 200) && !data.payment_method_id.matches('.*[/].*')
        && validOrderItems(data.items) && data.subtotal is int
        && data.subtotal == orderLineTotal(data.items, 0) + orderLineTotal(data.items, 1) + orderLineTotal(data.items, 2) + orderLineTotal(data.items, 3) + orderLineTotal(data.items, 4)
        && data.currency == 'usd' && data.status in ['requested', 'confirmed', 'fulfilled', 'cancelled'] && data.payment_status == 'unpaid';
    }
    // Infrastructure indices use deterministic keys; business records use numbered app-owned IDs.
    match /accountAccess/{firebaseUid} {
      allow get: if signedIn() && (request.auth.uid == firebaseUid || isOwner());
      allow list: if boundedList(100) && isOwner();
      allow create: if signedIn() && request.auth.uid == firebaseUid
        && exactKeys(request.resource.data, ['user_id'])
        && validText(request.resource.data.user_id, 1, 200)
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.user_id))
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.firebase_uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role == 'subscriber'
        && hasStatus(getAfter(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data, 'active')
        && matchingCounter('users', request.resource.data.user_id, getAfter(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.number);
      allow update: if signedIn() && request.auth.uid == firebaseUid && recentlyAuthenticated()
        && !resource.data.keys().hasAny(['account_status'])
        && exactKeys(request.resource.data, ['user_id', 'account_status'])
        && request.resource.data.user_id == resource.data.user_id && request.resource.data.account_status == 'deleting'
        && getAfter(/databases/$(database)/documents/users/$(resource.data.user_id)).data.firebase_uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(resource.data.user_id)).data.account_status == 'deleting';
      allow delete: if isOwner() && !resource.data.keys().hasAny(['account_status']);
    }
    match /counters/{collectionName} {
      allow get: if collectionName in ['contactSubmissions', 'appointmentSubmissions', 'orders']
        || (collectionName in ['events', 'products', 'services', 'reviews', 'paymentMethods', 'notifications'] && isAdmin())
        || (collectionName in ['roleChanges', 'featureSettings'] && isOwner())
        || (signedIn() && collectionName == 'users'
          && (!exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid)) || activeAccount()));
      allow list: if boundedList(100) && isOwner();
      allow create, update: if collectionName in ['events', 'users', 'contactSubmissions', 'appointmentSubmissions', 'orders', 'products', 'services', 'reviews', 'paymentMethods', 'notifications', 'roleChanges', 'featureSettings']
        && exactKeys(request.resource.data, ['number', 'record_id'])
        && request.resource.data.number is int
        && request.resource.data.number == (exists(/databases/$(database)/documents/counters/$(collectionName)) ? resource.data.number + 1 : 1)
        && validText(request.resource.data.record_id, 1, 200)
        && !exists(/databases/$(database)/documents/$(collectionName)/$(request.resource.data.record_id))
        && validCounterRecord(collectionName, request.resource.data.record_id, request.resource.data.number);
      allow delete: if false;
    }
    match /featureSettings/{id} {
      allow get: if id == 'FeatureSettings_1_Global_4_23_PM_10_12_26_b39e4e10-d4d7-41cf-9c5f-40a6a4703e90';
      allow list, delete: if false;
      allow create: if isOwner() && validFeatureSettings(request.resource.data, id) && freeFeaturePlans(request.resource.data)
        && request.resource.data.created_at == request.time && request.resource.data.updated_at == request.time
        && matchingCounter('featureSettings', id, 1);
      allow update: if isOwner() && validFeatureSettings(request.resource.data, id)
        && request.resource.data.id == resource.data.id && request.resource.data.number == resource.data.number
        && request.resource.data.type == resource.data.type && request.resource.data.name == resource.data.name
        && request.resource.data.version == resource.data.version && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time && retainedFeaturePlans(request.resource.data, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['features', 'updated_at']);
    }
    match /users/{id} {
      allow get: if signedIn() && ((ownProfile(id)
        && (!exists(/databases/$(database)/documents/users/$(id)) || resource.data.firebase_uid == request.auth.uid)) || isAdmin());
      allow list: if boundedList(51) && isAdmin();
      allow create: if signedIn() && validUser(request.resource.data, id) && hasStatus(request.resource.data, 'active')
        && request.resource.data.firebase_uid == request.auth.uid && request.resource.data.email == request.auth.token.email
        && ((request.resource.data.provider == 'google' && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email_verified == true)
          || (request.resource.data.provider == 'password' && request.auth.token.firebase.sign_in_provider == 'password'))
        && request.resource.data.role == 'subscriber'
        && request.resource.data.created_at == request.time && request.resource.data.updated_at == request.time
        && !exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/accountAccess/$(request.auth.uid)).data.user_id == id
        && matchingCounter('users', id, request.resource.data.number);
      allow update: if validUser(request.resource.data, id)
        && request.resource.data.id == resource.data.id && request.resource.data.number == resource.data.number
        && request.resource.data.firebase_uid == resource.data.firebase_uid && request.resource.data.provider == resource.data.provider
        && request.resource.data.created_at == resource.data.created_at && request.resource.data.updated_at == request.time
        && ((isOwner() && !hasStatus(resource.data, 'deleting') && hasStatus(request.resource.data, resource.data.get('account_status', 'active'))
            && (request.resource.data.role == resource.data.role || auditedRoleUpdate(request.resource.data, id)))
          || (activeAccount() && ownProfile(id) && resource.data.firebase_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo_url', 'theme_mode', 'updated_at']))
          || ownLifecycleUpdate(request.resource.data, id));
      allow delete: if (isOwner() && !hasStatus(resource.data, 'deleting'))
        || (ownProfile(id) && resource.data.firebase_uid == request.auth.uid && hasStatus(resource.data, 'deleting') && deletingAccount() && recentlyAuthenticated());
    }
    match /roleChanges/{id} {
      allow get: if isOwner();
      allow list: if boundedList(100) && isOwner();
      allow create: if validRoleChange(request.resource.data, id) && authorizedRoleChange(request.resource.data)
        && matchingCounter('roleChanges', id, request.resource.data.number);
      allow update, delete: if false;
    }
    match /contactSubmissions/{id} {
      allow get: if signedIn() && (resource.data.firebase_uid == request.auth.uid || isAdmin());
      allow list: if boundedList(100) && signedIn() && (resource.data.firebase_uid == request.auth.uid || isAdmin());
      allow create: if featureEnabled('contact') && validContact(request.resource.data, id) && request.resource.data.status == 'new'
        && newSubmission(request.resource.data, 'contactSubmissions', id);
      allow update: if adminSubmissionWrite(resource.data) && validContact(request.resource.data, id) && immutableSubmissionFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']);
      allow delete: if ownerSubmissionWrite(resource.data) || ownSubmissionDelete(resource.data);
    }
    match /appointmentSubmissions/{id} {
      allow get: if signedIn() && (resource.data.firebase_uid == request.auth.uid || isAdmin());
      allow list: if boundedList(100) && signedIn() && (resource.data.firebase_uid == request.auth.uid || isAdmin());
      allow create: if validAppointment(request.resource.data, id) && request.resource.data.status == 'requested'
        && newSubmission(request.resource.data, 'appointmentSubmissions', id);
      allow update: if adminSubmissionWrite(resource.data) && validAppointment(request.resource.data, id) && immutableSubmissionFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']);
      allow delete: if ownerSubmissionWrite(resource.data) || ownSubmissionDelete(resource.data);
    }
    match /catalogSlugs/{slugId} {
      allow get: if isAdmin();
      allow list: if boundedList(51) && isAdmin();
      allow create, update: if isAdmin()
        && exactKeys(request.resource.data, ['collection_name', 'record_id', 'slug'])
        && request.resource.data.collection_name in ['products', 'services', 'notifications'] && validSlug(request.resource.data.slug)
        && validText(request.resource.data.record_id, 1, 200)
        && slugId == request.resource.data.collection_name + '_' + request.resource.data.slug
        && getAfter(/databases/$(database)/documents/$(request.resource.data.collection_name)/$(request.resource.data.record_id)).data.slug == request.resource.data.slug
        && (!exists(/databases/$(database)/documents/catalogSlugs/$(slugId)) || request.resource.data.record_id == resource.data.record_id);
      allow delete: if isAdmin()
        && ((resource.data.collection_name == 'notifications'
            && !existsAfter(/databases/$(database)/documents/notifications/$(resource.data.record_id)))
          || getAfter(/databases/$(database)/documents/$(resource.data.collection_name)/$(resource.data.record_id)).data.slug != resource.data.slug);
    }
    match /products/{id} {
      allow get, list: if (resource != null && resource.data.status == 'active') || isAdmin();
      allow create: if validProduct(request.resource.data, id) && matchingSlug('products', request.resource.data)
        && newCommerceRecord(request.resource.data, 'products', id);
      allow update: if isAdmin() && validProduct(request.resource.data, id) && immutableCommerceFields(request.resource.data)
        && matchingSlug('products', request.resource.data);
      allow delete: if false;
    }
    match /services/{id} {
      allow get, list: if (resource != null && resource.data.status == 'active') || isAdmin();
      allow create: if validService(request.resource.data, id) && matchingSlug('services', request.resource.data)
        && newCommerceRecord(request.resource.data, 'services', id);
      allow update: if isAdmin() && validService(request.resource.data, id) && immutableCommerceFields(request.resource.data)
        && matchingSlug('services', request.resource.data);
      allow delete: if false;
    }
    match /reviews/{id} {
      allow get, list: if (resource != null && resource.data.status == 'published') || isAdmin();
      allow create: if validReview(request.resource.data, id) && newCommerceRecord(request.resource.data, 'reviews', id);
      allow update: if isAdmin() && validReview(request.resource.data, id) && immutableCommerceFields(request.resource.data);
      allow delete: if false;
    }
    match /paymentMethods/{id} {
      allow get, list: if (resource != null && resource.data.status == 'active') || isAdmin();
      allow create: if validPaymentMethod(request.resource.data, id) && newCommerceRecord(request.resource.data, 'paymentMethods', id);
      allow update: if isAdmin() && validPaymentMethod(request.resource.data, id) && immutableCommerceFields(request.resource.data);
      allow delete: if false;
    }
    match /orders/{id} {
      allow get: if signedIn() && (resource.data.firebase_uid == request.auth.uid || isAdmin());
      allow list: if boundedList(100) && signedIn() && (resource.data.firebase_uid == request.auth.uid || isAdmin());
      allow create: if validOrder(request.resource.data, id) && request.resource.data.status == 'requested'
        && trustedOrderItems(request.resource.data.items) && availablePaymentMethod(request.resource.data.payment_method_id)
        && newSubmission(request.resource.data, 'orders', id);
      allow update: if adminSubmissionWrite(resource.data) && validOrder(request.resource.data, id)
        && immutableSubmissionFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']);
      allow delete: if ownSubmissionDelete(resource.data);
    }
    match /notifications/{id} {
      allow get: if (resource != null && resource.data.status == 'published' && featureEnabled('notifications')) || isAdmin();
      allow list: if (boundedList(100) && resource != null && resource.data.status == 'published' && featureEnabled('notifications')) || (boundedList(100) && isAdmin());
      allow create: if validNotification(request.resource.data, id) && matchingSlug('notifications', request.resource.data)
        && newCommerceRecord(request.resource.data, 'notifications', id);
      allow update: if isAdmin() && validNotification(request.resource.data, id) && immutableCommerceFields(request.resource.data)
        && matchingSlug('notifications', request.resource.data)
        && (resource.data.slug == request.resource.data.slug
          || !existsAfter(/databases/$(database)/documents/catalogSlugs/$('notifications_' + resource.data.slug)));
      allow delete: if isAdmin()
        && !existsAfter(/databases/$(database)/documents/catalogSlugs/$('notifications_' + resource.data.slug));
    }
    match /events/{id} {
      allow get: if isAdmin();
      allow list: if boundedList(51) && isAdmin();
      allow create: if validEvent(request.resource.data, id) && newCommerceRecord(request.resource.data, 'events', id);
      allow update: if isAdmin() && validEvent(request.resource.data, id) && immutableCommerceFields(request.resource.data);
      allow delete: if false;
    }
  }
}
